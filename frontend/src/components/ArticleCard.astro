---
interface Props {
  title: string;
  excerpt: string;
  date: string;
  readingTime: string;
  category?: string;
  featuredImage?: string;
  imageWidth?: number;
  imageHeight?: number;
  slug: string;
}

const { title, excerpt, date, readingTime, category, featuredImage, imageWidth = 800, imageHeight = 600, slug } = Astro.props;
---

<article class="bg-white rounded-lg shadow-md overflow-hidden">
  {featuredImage ? (
    <img 
      src={featuredImage} 
      alt={title} 
      width={imageWidth}
      height={imageHeight}
      class="w-full h-48 object-cover"
      loading="lazy"
    />
  ) : null}
  <div class="p-6">
    <div class="text-sm text-gray-500 mb-2">
      <span>{date}</span> • <span>{readingTime}</span>
      {category ? <span> • <span class="text-red-500">{category}</span></span> : null}
    </div>
    <h2 class="text-xl font-bold mb-2">
      <a href={`/blog/${slug}`} class="text-gray-900 hover:text-blue-600">
        {title}
      </a>
    </h2>
    <div class="text-gray-600 mb-4" set:html={excerpt} />
    <a href={`/blog/${slug}`} class="text-blue-600 font-bold hover:underline">
      Lire plus →
    </a>
  </div>
</article>
