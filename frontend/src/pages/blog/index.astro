---
import Layout from '../../components/layout/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getAllPosts } from '../../data/strapi';
import { transformStrapiPost } from '../../shared/transformStrapiPost';
import type { TransformedPost } from '../../shared/types';

let rawPosts = [];
try {
  rawPosts = await getAllPosts(100); // Tous les articles bruts
} catch (error) {
  const message = error instanceof Error ? error.message : 'Erreur inconnue';
  console.error('Erreur lors de la récupération des articles depuis Strapi:', message);
  // En cas d'erreur (Strapi non disponible), on continue avec un tableau vide
}

const posts: TransformedPost[] = rawPosts.map(transformStrapiPost).filter((post): post is TransformedPost => post !== null);
---

<Layout title="Blog" description="Découvrez tous nos articles">
  <div class="container mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold mb-8">Tous les articles</h1>
    
    {posts.length === 0 ? (
      <div class="text-center py-12">
        <p class="text-gray-600 text-lg mb-4">Aucun article pour le moment.</p>
        <p class="text-gray-500 text-sm">
          {rawPosts.length > 0 
            ? 'Les articles ont été récupérés mais la transformation a échoué. Vérifiez la console pour plus de détails.'
            : 'Aucun article n\'a été récupéré depuis Strapi. Vérifiez que Strapi est démarré et que les permissions sont configurées.'}
        </p>
      </div>
    ) : (
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post) => (
          <ArticleCard 
            title={post.title}
            excerpt={post.excerpt}
            date={post.date}
            readingTime={post.readingTime}
            featuredImage={post.featuredImage}
            imageWidth={post.imageWidth}
            imageHeight={post.imageHeight}
            slug={post.slug}
          />
        ))}
      </div>
    )}
  </div>
</Layout>